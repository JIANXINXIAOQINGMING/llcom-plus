<Page x:Class="llcom_plus.Pages.LogAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageHeading" Text="串口时间线" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Width="200" Margin="0,0,6,6" ToolTip="关键字 / HEX / 正则，Ctrl+F" TextChanged="FilterChanged"/>
            <ComboBox x:Name="ModeBox" Width="94" SelectedIndex="0" Margin="0,0,6,6" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="文本" ToolTip="Text"/><ComboBoxItem Content="HEX"/><ComboBoxItem Content="正则" ToolTip="Regex"/>
            </ComboBox>
            <ComboBox x:Name="PortBox" Width="116" IsEditable="True" Text="全部串口" Margin="0,0,6,6" ToolTip="选择或输入 COM；全部串口可查看多口时间线" DropDownOpened="PortsOpened" SelectionChanged="FilterChanged"/>
            <ComboBox x:Name="KindBox" Width="134" SelectedIndex="0" Margin="0,0,6,6" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="全部 / All" Tag=""/><ComboBoxItem Content="TX" Tag="Tx"/>
                <ComboBoxItem Content="RX" Tag="Rx"/><ComboBoxItem Content="引脚 / Pin" Tag="Pin"/>
                <ComboBoxItem Content="错误 / Error" Tag="Error"/><ComboBoxItem Content="事件 / Info" Tag="Info"/>
                <ComboBoxItem Content="低功耗 / Power" Tag="Power"/>
            </ComboBox>
            <CheckBox x:Name="BookmarksOnly" Content="仅书签" VerticalAlignment="Center" Margin="0,0,8,6" Click="FilterChanged"/>
            <Button Content="搜索" Click="Search_Click" Margin="0,0,6,6"/>
            <Button x:Name="PauseButton" Content="暂停视图" Click="Pause_Click" Margin="0,0,6,6"/>
            <Button Content="导出 CSV" Click="Export_Click" Margin="0,0,0,6"/>
        </WrapPanel>
        <DataGrid x:Name="Records" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                  SelectionUnit="FullRow" SelectionChanged="Records_SelectionChanged"
                  SizeChanged="Records_SizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="★" Binding="{Binding Marker}" Width="30"/>
                <DataGridTextColumn Header="时间 / Time" Binding="{Binding Time}" Width="105"/>
                <DataGridTextColumn Header="COM" Binding="{Binding Port}" Width="62"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="58"/>
                <DataGridTextColumn x:Name="DataColumn" Header="数据 / Event" Binding="{Binding Preview}" MinWidth="150" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,6">
            <Button Content="★ 书签" Click="Bookmark_Click" DockPanel.Dock="Right" ToolTip="添加或移除选中记录的书签"/>
            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <Expander Grid.Row="4" Header="选中记录详情 / 原始 HEX">
            <TextBox x:Name="Details" Height="85" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </Expander>
        <StackPanel Grid.Row="5" Margin="0,7,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource AppGlassMutedBrush}"/>
            <TextBlock x:Name="HelpText" Text="Ctrl+点选两条记录可计算间隔。筛选不影响原始日志。仅保留最近 10,000 条 / 16 MiB。时间是主机观测值，并非硬件采样或功耗值。"
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AppGlassMutedBrush}"/>
        </StackPanel>
    </Grid>
</Page>
