<Page
    x:Class="llcom_plus.Pages.CircularSendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="620"
    d:DesignWidth="920"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="CircularActionButtonStyle" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
    </Page.Resources>
    <Grid Margin="12" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The selected tool in the navigation already supplies the page title. -->
        <WrapPanel
            x:Name="CircularToolbar"
            Margin="0,0,0,2"
            HorizontalAlignment="Right"
            ItemHeight="44">
            <Button
                Width="72"
                Height="36"
                Margin="0,0,8,0"
                Click="AddRowButton_Click"
                Content="{DynamicResource CircularSendAddRow}"
                Style="{StaticResource CircularActionButtonStyle}" />
            <Button
                Width="72"
                Height="36"
                Margin="0,0,8,0"
                Click="ClearButton_Click"
                Content="{DynamicResource CircularSendClear}"
                Style="{StaticResource CircularActionButtonStyle}" />
            <Button
                Width="136"
                Height="36"
                Margin="0,0,8,0"
                Click="ImportQuickSendButton_Click"
                Content="{DynamicResource CircularSendImportQuickSend}"
                Style="{StaticResource CircularActionButtonStyle}" />
            <Button Height="36" Padding="10,3" Click="ExportReportButton_Click"
                    Content="导出测试报告" ToolTip="导出本次保留的步骤结果为 CSV，不会发送数据"
                    Style="{StaticResource CircularActionButtonStyle}" />
        </WrapPanel>

        <TextBlock
            x:Name="StorageErrorTextBlock"
            Grid.Row="1"
            Margin="0,2,0,6"
            Foreground="IndianRed"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <DataGrid
            x:Name="CommandDataGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding Items}"
            SelectedIndex="0"
            SelectionMode="Single"
            SizeChanged="CommandDataGrid_SizeChanged"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="44" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridCheckBoxColumn.Header>
                        <StackPanel HorizontalAlignment="Center">
                            <CheckBox
                                x:Name="EnableAllCheckBox"
                                HorizontalAlignment="Center"
                                IsThreeState="True"
                                PreviewKeyDown="EnableAllCheckBox_PreviewKeyDown"
                                PreviewMouseLeftButtonDown="EnableAllCheckBox_PreviewMouseLeftButtonDown"
                                ToolTip="{DynamicResource CircularSendSelectAll}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                Text="{DynamicResource CircularSendEnabled}" />
                        </StackPanel>
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Width="28" Binding="{Binding Index}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource CircularSendIndex}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="CommandColumn" Width="72" MinWidth="72" Binding="{Binding Command, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource CircularSendCommand}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Width="42" Binding="{Binding Hex, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridCheckBoxColumn.Header>
                        <TextBlock Text="{DynamicResource CircularSendHex}" />
                    </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn Width="68" Binding="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource CircularSendDelay}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Width="88" Binding="{Binding Status}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource CircularSendStatus}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button
                                    MinWidth="42"
                                    Margin="0,0,4,0"
                                    Click="SendOneButton_Click"
                                    Content="{DynamicResource CircularSendSendOne}"
                                    Style="{StaticResource CircularActionButtonStyle}"
                                    Tag="{Binding}" />
                                <Button
                                    MinWidth="42"
                                    Click="RemoveRowButton_Click"
                                    Content="{DynamicResource CircularSendRemoveRow}"
                                    Style="{StaticResource CircularActionButtonStyle}"
                                    Tag="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Expander Grid.Row="3" Header="步骤验证 · 选中一行设置预期响应" Margin="0,8,0,0" IsExpanded="True">
            <StackPanel x:Name="StepOptionsPanel" Margin="4,6" DataContext="{Binding SelectedItem, ElementName=CommandDataGrid}">
                <WrapPanel>
                    <TextBlock Text="响应匹配" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <ComboBox Width="112" Height="32" Margin="0,0,12,6" SelectedIndex="{Binding ExpectationMode, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="不验证" />
                        <ComboBoxItem Content="包含文本" />
                        <ComboBoxItem Content="整行等于" />
                        <ComboBoxItem Content="正则表达式" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                    <TextBlock Text="预期响应" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox MinWidth="150" Width="220" Height="32" Margin="0,0,12,6"
                             Text="{Binding ExpectedResponse, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如 OK。文本区分大小写；整行等于会等待行结束；正则支持 (?i)。" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="超时 (ms)" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Width="72" Height="32" Margin="0,0,12,6" Text="{Binding ResponseTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="超时重试" VerticalAlignment="Center" Margin="0,0,6,6" />
                    <TextBox Width="48" Height="32" Margin="0,0,12,6" Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="响应验证失败后继续下一步" VerticalAlignment="Center" Margin="0,0,0,6"
                              IsChecked="{Binding ContinueOnFailure, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
                <TextBlock Foreground="{DynamicResource AppGlassMutedBrush}" TextWrapping="Wrap" FontSize="11"
                           Text="重试可能重复执行指令，默认 0。只验证当前捕获的单个 COM；接收内容按规则匹配，不会自动区分同端口的主动上报。" />
            </StackPanel>
        </Expander>

        <Expander Grid.Row="4" Header="本次测试结果" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock x:Name="ReportSummaryTextBlock" Margin="4,4" TextWrapping="Wrap" Text="暂无测试结果。" />
                <DataGrid Height="150" ItemsSource="{Binding ReportItems}" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="轮 / 步" Width="64" Binding="{Binding StepLabel}" />
                        <DataGridTextColumn Header="串口" Width="65" Binding="{Binding Port}" />
                        <DataGridTextColumn Header="结果" Width="78" Binding="{Binding Outcome}" />
                        <DataGridTextColumn Header="响应 ms" Width="70" Binding="{Binding ResponseMs}" />
                        <DataGridTextColumn Header="次数" Width="44" Binding="{Binding Attempts}" />
                        <DataGridTextColumn Header="详情" Width="*" Binding="{Binding Details}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Expander>

        <WrapPanel
            Grid.Row="5"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            ItemHeight="44">
            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{DynamicResource CircularSendTimes}" />
                <TextBox
                    x:Name="RunTimesTextBox"
                    Width="76"
                    Height="34"
                    Margin="6,0,0,0"
                    HorizontalContentAlignment="Center"
                    Text="1"
                    ToolTip="{DynamicResource CircularSendTimesTip}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{DynamicResource CircularSendDefaultDelay}" />
                <TextBox
                    x:Name="DefaultDelayTextBox"
                    Width="86"
                    Height="34"
                    Margin="6,0,0,0"
                    HorizontalContentAlignment="Center"
                    Text="1000"
                    ToolTip="{DynamicResource CircularSendDefaultDelayTip}" />
            </StackPanel>
                <TextBlock
                    x:Name="StatusTextBlock"
                    MinWidth="58"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="{DynamicResource CircularSendIdle}" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="StartButton"
                        Width="104"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="StartButton_Click"
                        Style="{DynamicResource AppAccentButtonStyle}">
                        <TextBlock
                            Foreground="{DynamicResource AppAccentBrush}"
                            Text="{DynamicResource CircularSendStart}" />
                    </Button>
                    <Button
                        x:Name="StopButton"
                        Width="88"
                        Height="36"
                        Click="StopButton_Click"
                        Content="{DynamicResource CircularSendStop}"
                        IsEnabled="False"
                        Style="{StaticResource CircularActionButtonStyle}" />
                </StackPanel>
        </WrapPanel>
    </Grid>
</Page>
