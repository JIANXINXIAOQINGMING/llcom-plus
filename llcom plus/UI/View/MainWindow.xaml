                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesome VerticalAlignment="Center" FontSize="14" Icon="Upload" />
                                            <TextBlock Margin="6,0,6,0" Text="{DynamicResource QuickSendExportShort}" />
                                            <fa:FontAwesome VerticalAlignment="Center" FontSize="10" Icon="CaretDown" />
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Name="QuickSendExportButton" Header="{DynamicResource QuickSendExport}" Click="QuickSendExportButton_Click" />
                                                <MenuItem Name="QuickSendExportAllButton" Header="{DynamicResource QuickSendExportAll}" Click="QuickSendExportAllButton_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        MaxWidth="170"
                                        Margin="8,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        ToolTip="{DynamicResource QuickSendBackupDescription}"
                                        AutomationProperties.Name="{DynamicResource QuickSendBackupAutoStatus}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesome
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource AppSuccessBrush}"
                                                Icon="CheckCircle" />
                                        </StackPanel>
                                    </Border>
                                    <Button
                                        Name="QuickSendBackupButton"
                                        AutomationProperties.Name="{DynamicResource QuickSendBackupManage}"
                                        Click="QuickSendBackupButton_Click"
                                        Style="{StaticResource QuickSendCommandButtonStyle}"
                                        ToolTip="{DynamicResource QuickSendBackupManage}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:FontAwesome VerticalAlignment="Center" FontSize="13" Icon="History" />
                                            <TextBlock Margin="6,0,0,0" Text="{DynamicResource QuickSendBackupManage}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem x:Name="TimelineTab" Header="{DynamicResource TimelineTabTitle}" Margin="0,2,0,-8" Width="104">
                    <Frame x:Name="MainTimelineFrame" NavigationUIVisibility="Hidden" Background="Transparent" BorderThickness="0" />
                </TabItem>
                <TabItem Name="ScriptTab" Header="{DynamicResource ScriptCard}" Margin="0,2,0,-8" Width="104">
                    <Grid>
                        <!--  脚本编辑界面  -->
                        <Grid Name="scriptEditorGrid" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,5" Orientation="Horizontal">
                                <ComboBox
                                Name="scriptFileList"
                                Width="260"
                                SelectionChanged="ScriptFileList_SelectionChanged" />
                                <Button
                                Name="newScriptButton"
                                Margin="3,0,0,0"
                                Click="NewScriptButton_Click"
                                ToolTip="{DynamicResource ScriptNewScript}">
                                    <Grid>
                                        <fa:FontAwesome Foreground="{DynamicResource AppInfoBrush}" Icon="File" />
                                        <fa:FontAwesome Icon="FileCodeOutline" />
                                    </Grid>
                                </Button>
                                <Button
                                Name="runScriptButton"
                                Margin="2,0,0,0"
                                Click="RunScriptButton_Click"
                                ToolTip="{DynamicResource ScriptRunScript}">
                                    <fa:FontAwesome Foreground="{DynamicResource AppSuccessBrush}" Icon="Play" />
                                </Button>
                                <Button
                                Name="openScriptFolderButton"
                                Margin="2,0,0,0"
                                Click="OpenScriptFolderButton_Click"
                                ToolTip="{DynamicResource ScriptOpenFolder}">
                                    <Grid>
                                        <fa:FontAwesome Foreground="{DynamicResource AppWarningBrush}" Icon="FolderOpen" />
                                        <fa:FontAwesome Icon="FolderOutlinepenOutline" />
                                    </Grid>
                                </Button>
                                <Button
                                Name="refreshScriptListButton"
                                Margin="2,0,0,0"
                                Click="RefreshScriptListButton_Click"
                                ToolTip="{DynamicResource ScriptRefreshList}">
                                    <fa:FontAwesome Foreground="{DynamicResource AppSuccessBrush}" Icon="Refresh" />
                                </Button>
                                <Button
                                Name="apiDocumentButton"
                                Margin="2,0,0,0"
                                Click="ApiDocumentButton_Click"
                                ToolTip="{DynamicResource ScriptApiReference}">
                                    <fa:FontAwesome Foreground="{DynamicResource AppIconBrush}" Icon="Book" />
                                </Button>
                            </WrapPanel>
                            <WrapPanel
                            Name="newScriptFileWrapPanel"
                            Grid.Row="1"
                            Margin="3"
                            Visibility="Collapsed">
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource ScriptFileName}" />
                                <TextBox
                                Name="newScriptFileNameTextBox"
                                Width="90"
                                Text="new script" />
                                <Button
                                Name="newScriptFileButton"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="NewScriptFileButton_Click"
                                ToolTip="{DynamicResource ScriptConfirmCreate}">
                                    <fa:FontAwesome Foreground="{DynamicResource AppSuccessBrush}" Icon="Check" />
                                </Button>
                                <Button
                                Name="newScriptFileCancelButton"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="NewScriptFileCancelButton_Click"
                                ToolTip="{DynamicResource ScriptCancel}">
                                    <fa:FontAwesome Foreground="{DynamicResource AppDangerBrush}" Icon="Ban" />
                                </Button>
                            </WrapPanel>
                            <avalonEdit:TextEditor
                            xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                            Name="textEditor"
                            Grid.Row="2"
                            FontFamily="Consolas"
                            FontSize="10pt"
                            Background="{DynamicResource AppCodeBackgroundBrush}"
                            Foreground="{DynamicResource AppGlassTextBrush}"
                            LineNumbersForeground="{DynamicResource AppGlassMutedBrush}"
                            LostFocus="TextEditor_LostFocus"
                            ShowLineNumbers="True"
                            TextChanged="textEditor_TextChanged" />
                        </Grid>
                        <!--  脚本编辑界面END  -->

                        <!--  脚本运行日志界面  -->
                        <Grid Name="scriptLogShowGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                            Name="scriptLogTextBox"
                            VerticalContentAlignment="Top"
                            IsReadOnly="true"
                            MouseLeave="scriptLogTextBox_MouseLeave"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                Name="stopScriptButton"
                                Margin="0,3,3,3"
                                Click="StopScriptButton_Click"
                                Foreground="{DynamicResource AppDangerBrush}"
                                ToolTip="{DynamicResource ScriptStop}">
                                    <fa:FontAwesome Name="stopScriptOrExitIcon" Icon="Stop" />
                                </Button>
                                <Button
                                Name="pauseScriptPrintButton"
                                Grid.Column="1"
                                Margin="0,3,3,3"
                                Click="PauseScriptPrintButton_Click"
                                Foreground="{DynamicResource AppSuccessBrush}"
                                MouseRightButtonUp="pauseScriptPrintButton_MouseRightButtonUp"
                                ToolTip="{DynamicResource ScriptPause}">
                                    <fa:FontAwesome Name="pauseScriptPrintIcon" Icon="Pause" />
                                </Button>
                                <TextBox
                                Name="runOneLineScriptTextBox"
                                Grid.Column="2"
                                Margin="0,3"
                                KeyDown="RunOneLineScriptTextBox_KeyDown" />
                                <Button
                                Name="sendScriptCommandButton"
                                Grid.Column="3"
                                Margin="3,3,0,3"
                                Click="SendScriptCommandButton_Click"
                                Foreground="{DynamicResource AppInfoBrush}"
                                ToolTip="{DynamicResource ScriptSendCommand}">
                                    <fa:FontAwesome Icon="ArrowUp" />
                                </Button>
                            </Grid>
                        </Grid>
                        <!--  脚本运行日志界面END  -->
                    </Grid>
                </TabItem>
                <TabItem Name="ToolsTab" Header="{DynamicResource ToolsTab}" Margin="0,2,0,-8" Width="104">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                        Grid.Column="0"
                        Padding="6"
                        Style="{StaticResource GlassPanelTightStyle}">
                            <DockPanel>
                            <Button DockPanel.Dock="Top" Content="★ 设为 / 取消常用" Margin="0,0,0,6"
                                    ToolTip="收藏当前工具，不会中断正在运行的任务" Click="ToggleToolFavorite_Click"/>
                            <ListBox
                            Name="ToolListBox"
                            ItemContainerStyle="{StaticResource ToolListItemStyle}"
                            SelectionChanged="ToolListBox_SelectionChanged"
                            Style="{StaticResource ToolListBoxStyle}">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Name}" Margin="3,9,0,6" TextWrapping="Wrap"
                                                FontSize="11" Foreground="{DynamicResource AppGlassMutedBrush}"/></DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Foreground="{DynamicResource AppGlassTextBrush}"
                                            Text="{Binding Title}"
                                            TextOptions.TextFormattingMode="Display"
                                            TextOptions.TextHintingMode="Fixed"
                                            TextOptions.TextRenderingMode="ClearType" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </DockPanel>
                        </Border>
                        <Border
                        Grid.Column="2"
                        Padding="8"
                        Background="{DynamicResource AppToolContentBackground}"
                        BorderBrush="{DynamicResource AppGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ToolContentColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Name="ToolContentHost"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <Border
            Grid.RowSpan="2"
            Grid.Column="3"
            MinWidth="580"
            Margin="10,12,12,8"
            CornerRadius="18"
            Style="{StaticResource FloatingGlassHighlightStyle}" />

        <Grid
            x:Name="RightTopActions"
            Grid.Column="3"
            Margin="0,18,20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Border Style="{StaticResource FloatingGlassShadowStyle}" CornerRadius="15" />
            <Border
                Padding="4"
                Background="{DynamicResource AppGlassPanelBackground}"
                BorderBrush="{DynamicResource AppGlassHighlightBrush}"
                BorderThickness="1"
                CornerRadius="15">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Name="NotificationCenterButton"
                        Width="36"
                        Height="36"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="NotificationCenterButton_Click"
                        ToolTip="{DynamicResource NotificationCenterTitle}">
                        <Grid Width="26" Height="26">
                            <fa:FontAwesome
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{DynamicResource AppGlassTextBrush}"
                                Icon="BellOutline" />
                            <Border
                                Name="NotificationBadge"
                                MinWidth="16"
                                Height="16"
                                Margin="0,-4,-5,0"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AppDangerBrush}"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    Name="NotificationBadgeText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="0" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button
                        Name="ThemeToggleMenuItem"
                        Width="36"
                        Height="36"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="ThemeToggleMenuItem_Click"
                        ToolTip="{DynamicResource DarkMode}">
                        <fa:FontAwesome
                            Name="ThemeToggleIcon"
                            Width="16"
                            Height="16"
                            FontSize="16"
                            Foreground="{DynamicResource AppAccentBrush}"
                            Icon="Adjust" />
                    </Button>
                    <Button
                        Name="LanguageMenuButton"
                        Width="36"
                        Height="36"
                        Margin="0,0,4,0"
                        Padding="0"
                        Click="LanguageMenuButton_Click"
                        ToolTip="{DynamicResource ChangeLanguage}">
                        <fa:FontAwesome
                            Width="16"
                            Height="16"
                            FontSize="16"
                            Foreground="{DynamicResource AppInfoBrush}"
                            Icon="Globe" />
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom" VerticalOffset="6">
                                <MenuItem
                                    Click="MenuItem_Click"
                                    Header="简体中文"
                                    Tag="zh-CN" />
                                <MenuItem
                                    Click="MenuItem_Click"
                                    Header="English"
                                    Tag="en-US" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        Name="CheckUpdateButton"
                        Width="36"
                        Height="36"
                        Padding="0"
                        Click="CheckUpdateButton_Click"
                        ToolTip="{DynamicResource AboutReleaseButton}">
                        <Grid Width="18" Height="18">
                            <fa:FontAwesome
                                Name="CheckUpdateIcon"
                                Width="17"
                                Height="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="17"
                                Foreground="{DynamicResource AppSuccessBrush}"
                                Icon="Refresh"
                                SpinDuration="1" />
                            <Border
                                Name="UpdateAvailableBadge"
                                Width="14"
                                Height="14"
                                Margin="0,-7,-8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AppDangerBrush}"
                                CornerRadius="7"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="!" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FloatingGlassHighlightStyle}" CornerRadius="15" />
        </Grid>

        <Popup
            Name="NotificationPopup"
            AllowsTransparency="True"
            Opened="NotificationPopup_Opened"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=NotificationCenterButton}"
            StaysOpen="True"
            VerticalOffset="7">
            <Grid
                Name="NotificationPopupRoot"
                Width="470"
                MaxHeight="510"
                Background="Transparent"
                PreviewMouseLeftButtonDown="NotificationDragHandle_MouseLeftButtonDown">
                <Border
                    Name="NotificationPopupSurface"
                    Margin="20"
                    Padding="12"
                    Background="{DynamicResource AppPopupBackground}"
                    BorderBrush="{DynamicResource AppGlassHighlightBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="14"
                            Direction="270"
                            Opacity="0.34"
                            RenderingBias="Quality"
                            ShadowDepth="4"
                            Color="{DynamicResource AppShadowColor}" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Name="NotificationHeader"
                            Margin="2,0,2,10">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="Auto" />
                             </Grid.ColumnDefinitions>
                             <StackPanel Orientation="Horizontal">
                                <fa:FontAwesome
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Foreground="{DynamicResource AppAccentBrush}"
                                    Icon="BellOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AppGlassTextBrush}"
                                    Text="{DynamicResource NotificationCenterTitle}" />
                            </StackPanel>
                            <ComboBox
                                Name="NotificationFilterComboBox"
                                Grid.Column="1"
                                Width="104"
                                Height="30"
                                Margin="8,0"
                                SelectionChanged="NotificationFilterComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Fill="{Binding IndicatorBrush}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                             <Button
                                 Name="NotificationClearButton"
                                Grid.Column="2"
                                MinWidth="58"
                                Padding="9,4"
                                Click="NotificationClearButton_Click"
                                 Content="{DynamicResource NotificationClear}"
                                 Style="{StaticResource GlassButtonStyle}" />
                             <Button
                                 Name="NotificationDetachButton"
                                 Grid.Column="3"
                                 Width="30"
                                 Height="30"
                                 Margin="0,0,6,0"
                                 Padding="0"
                                 Click="NotificationDetachButton_Click"
                                 Style="{StaticResource GlassButtonStyle}"
                                 ToolTip="{DynamicResource NotificationDetachTip}">
                                 <fa:FontAwesome FontSize="13" Icon="ThumbTack" />
                             </Button>
                         </Grid>
                        <Button
                            Name="NotificationDetachedCloseButton"
                            Grid.RowSpan="3"
                            Margin="0,-20,-20,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Panel.ZIndex="40"
                            Click="NotificationDetachedCloseButton_Click"
                            Content="×"
                            Style="{StaticResource NotificationCloseButtonStyle}"
                            ToolTip="{DynamicResource NotificationDetachedCloseTip}"
                            Visibility="Collapsed" />
                        <Border
                            Grid.Row="1"
                            MinHeight="130"
                            MaxHeight="360"
                            Padding="4"
                            Background="{DynamicResource AppGlassControlBackground}"
                            BorderBrush="{DynamicResource AppGlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                            <Grid>
                                <TextBlock
                                    Name="NotificationEmptyText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AppGlassMutedBrush}"
                                    Text="{DynamicResource NotificationEmpty}" />
                                <ListBox
                                    Name="NotificationListBox"
                                    MouseDoubleClick="NotificationListBox_MouseDoubleClick"
                                    ToolTip="双击定位到日志分析 / Double-click to locate in timeline"
                                    Padding="3"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,7"
                                                Padding="0"
                                                Background="{DynamicResource AppPopupBackground}"
                                                BorderBrush="{DynamicResource AppGlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Background="{Binding IndicatorBrush}"
                                                        CornerRadius="8,0,0,8" />
                                                    <Grid Grid.Column="1" Margin="9,8,10,8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                Margin="0,0,8,0"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource AppGlassTextBrush}"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontFamily="Consolas"
                                                                FontSize="10"
                                                                Foreground="{DynamicResource AppGlassMutedBrush}"
                                                                Text="{Binding TimeText}" />
                                                        </Grid>
                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Margin="0,5,0,0"
                                                            Foreground="{DynamicResource AppGlassMutedBrush}"
                                                            Text="{Binding Message}"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <TextBlock
                            Grid.Row="2"
                            Margin="3,8,3,0"
                            Foreground="{DynamicResource AppGlassMutedBrush}"
                            Text="{DynamicResource NotificationSessionOnly}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
                <Border
                    Margin="21"
                    CornerRadius="16"
                    Style="{StaticResource FloatingGlassHighlightStyle}" />
            </Grid>
        </Popup>
    </Grid>
</Window>
