                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
