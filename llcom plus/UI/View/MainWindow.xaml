                                                        MouseRightButtonDown="QuickSendButton_MouseRightButtonDown" Tag="{Binding}">
                                                    <TextBlock Text="{Binding commit}" TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                                                    <Button.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding commit}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{DynamicResource QuickSendButtonTip}" />
                                                        </StackPanel>
                                                    </Button.ToolTip>
                                                </Button>
                                                <Button x:Name="QuickSendRowSettingsButton" Grid.Column="3" Width="32" Height="30" Padding="0"
                                                        HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                        Click="QuickSendRowSettingsButton_Click" ToolTipOpening="QuickSendRowSettingsButton_ToolTipOpening"
                                                        Tag="{Binding}" ToolTip="{DynamicResource QuickSendItemSettings}"
                                                        AutomationProperties.Name="{DynamicResource QuickSendItemSettings}">
                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource QuickSendInlineButtonStyle}">
                                                            <Setter Property="Foreground" Value="{DynamicResource AppGlassMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasCustomOptions}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid Width="22" Height="22">
                                                        <fa:FontAwesome FontSize="16" Icon="Sliders" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                 Fill="{DynamicResource AppAccentBrush}"
                                                                 Visibility="{Binding HasCustomOptions, Converter={StaticResource boolVisibeConverter}}" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
