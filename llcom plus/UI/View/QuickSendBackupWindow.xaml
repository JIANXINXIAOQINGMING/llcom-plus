<Window
    x:Class="llcom_plus.QuickSendBackupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{DynamicResource QuickSendBackupWindowTitle}"
    Width="780"
    Height="470"
    MinWidth="660"
    MinHeight="380"
    WindowStartupLocation="CenterOwner">
    <Window.Style>
        <Style BasedOn="{StaticResource AppGlassWindowStyle}" TargetType="Window" />
    </Window.Style>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,12"
            Text="{DynamicResource QuickSendBackupDescription}"
            TextWrapping="Wrap" />

        <DataGrid
            x:Name="SnapshotsGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Width="190" Binding="{Binding TimeText}" Header="{DynamicResource QuickSendBackupTime}" />
                <DataGridTextColumn Width="*" MinWidth="120" Binding="{Binding Reason}" Header="{DynamicResource QuickSendBackupReason}" />
                <DataGridTextColumn Width="90" Binding="{Binding AppVersion}" Header="{DynamicResource QuickSendBackupVersion}" />
                <DataGridTextColumn Width="70" Binding="{Binding PageCount}" Header="{DynamicResource QuickSendBackupPages}" />
                <DataGridTextColumn Width="85" Binding="{Binding ItemCount}" Header="{DynamicResource QuickSendBackupItems}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock
            x:Name="EmptyMessage"
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Text="{DynamicResource QuickSendBackupEmpty}"
            Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Margin="0,0,8,0" Click="RestoreButton_Click" Content="{DynamicResource QuickSendBackupRestore}" Style="{StaticResource AppAccentButtonStyle}" />
            <Button Grid.Column="1" Margin="0,0,8,0" Click="ExportButton_Click" Content="{DynamicResource QuickSendBackupExport}" />
            <Button Grid.Column="2" Margin="0,0,8,0" Click="DeleteButton_Click" Content="{DynamicResource QuickSendBackupDelete}" />
            <Button Grid.Column="3" Click="OpenFolderButton_Click" Content="{DynamicResource QuickSendBackupOpenFolder}" />
            <Button Grid.Column="5" MinWidth="80" Click="CloseButton_Click" Content="{DynamicResource QuickSendBackupClose}" />
        </Grid>
    </Grid>
</Window>
