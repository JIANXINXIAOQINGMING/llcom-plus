<UserControl x:Class="llcom_plus.Views.LogFindBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed" Focusable="False" PreviewKeyDown="QueryKeyDown">
    <Border Padding="6,6,6,5" BorderThickness="0,0,0,1"
            Background="{DynamicResource AppGlassControlBackground}"
            BorderBrush="{DynamicResource AppGlassBorderBrush}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryBox" MinWidth="60" Height="30" Padding="7,2"
                         MaxLength="1024" VerticalContentAlignment="Center"
                         ToolTip="查找当前日志中显示的文字；Enter 下一项，Shift+Enter 上一项，Esc 关闭"
                         TextChanged="QueryChanged" />
                <Button x:Name="PreviousButton" Grid.Column="1" Width="30" Height="30" Margin="4,0,0,0"
                        Content="↑" ToolTip="上一项（Shift+Enter）" Click="PreviousClicked" />
                <Button x:Name="NextButton" Grid.Column="2" Width="30" Height="30" Margin="2,0,0,0"
                        Content="↓" ToolTip="下一项（Enter）" Click="NextClicked" />
                <Button Grid.Column="3" Width="30" Height="30" Margin="2,0,0,0"
                        Content="×" ToolTip="关闭查找（Esc），恢复原滚动设置" Click="CloseClicked" />
            </Grid>
            <WrapPanel Margin="2,4,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="MatchCaseBox" Content="Aa" Margin="0,0,9,0" VerticalAlignment="Center"
                          ToolTip="区分大小写" Checked="OptionsChanged" Unchecked="OptionsChanged" />
                <CheckBox x:Name="RegexBox" Content=".*" Margin="0,0,9,0" VerticalAlignment="Center"
                          ToolTip="正则表达式（多行模式）" Checked="OptionsChanged" Unchecked="OptionsChanged" />
                <TextBlock x:Name="StatusText" Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppGlassMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="RefreshButton" Padding="6,0" MinHeight="22" Height="22"
                        Content="刷新" ToolTip="把新收到的日志加入查找；接收和日志保存始终继续"
                        Click="RefreshClicked" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
