<Window
    x:Class="llcom_plus.AboutProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    Title="{DynamicResource AboutProjectTitle}"
    Width="550"
    MinWidth="400"
    MaxHeight="720"
    Icon="pack://application:,,,/Resources/Assets/AppIcon.ico"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SourceInitialized="Window_SourceInitialized"
    WindowStartupLocation="CenterOwner">
    <Window.Style>
        <Style BasedOn="{StaticResource AppGlassWindowStyle}" TargetType="Window" />
    </Window.Style>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,4">
                <Grid Margin="2,0,2,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ProjectLogo" Width="52" Height="52" Margin="0,0,14,0"
                           VerticalAlignment="Center" Source="pack://application:,,,/Resources/Assets/AppIcon.ico" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="23" FontWeight="SemiBold" Text="llcom plus" />
                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource AppGlassMutedBrush}">
                            <Run Text="{DynamicResource AboutProjectVersion}" /><Run Text=" " /><Run x:Name="VersionText" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <TextBlock Margin="2,0,2,14" Text="{DynamicResource AboutProjectDescription}" TextWrapping="Wrap" />
                <Border Padding="14,12" Style="{DynamicResource AppGlassCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,20,0" Foreground="{DynamicResource AppGlassMutedBrush}" Text="{DynamicResource AboutProjectAuthor}" />
                            <TextBlock x:Name="AuthorText" Grid.Column="1" FontWeight="SemiBold" Text="lawrenc.liu" />
                        </Grid>
                        <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="{DynamicResource AboutProjectFeaturesTitle}" />
                        <TextBlock Text="{DynamicResource AboutProjectFeatures}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="2,14,2,5" Foreground="{DynamicResource AppGlassMutedBrush}" Text="{DynamicResource AboutProjectCredits}" TextWrapping="Wrap" />
                <TextBlock Margin="2,0,2,12" Foreground="{DynamicResource AppGlassMutedBrush}" Text="{DynamicResource AboutProjectLicense}" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Margin="0,0,8,5" Padding="10,5" Click="ProjectHomeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:FontAwesome Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Icon="Github" />
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource AboutProjectHome}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,0,5" Padding="10,5" Click="UpstreamButton_Click" Content="{DynamicResource AboutProjectUpstream}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" MinWidth="84" Margin="0,12,0,0" HorizontalAlignment="Right"
                Click="CloseButton_Click" Content="{DynamicResource AboutProjectClose}" IsCancel="True" IsDefault="True" />
    </Grid>
</Window>
